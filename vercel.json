{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://apis.buzzel.dpdns.org/api/$1"
    },
    {
      "source": "/join/(.*)",
      "destination": "https://apis.buzzel.dpdns.org/join/$1"
    }
  ]
}
